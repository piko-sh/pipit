; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4 float64=2 complex128=4
;   dispatch:  asm=7 shim=4 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=10
;   complex: [0]=(5+12i)  [1]=(3+4i)

0000 S 0:LOAD_COMPLEX128_CONSTANT                             0   0   0
0001 S 0:LOAD_COMPLEX128_CONSTANT                             1   1   0
0002 S 0:SUBTRACT_COMPLEX128                                  2   0   1
0003 A 1:REAL_PART_COMPLEX128                                 9   0   2
0004 A 1:CONVERT_FLOAT64_TO_INT64                            51   0   0
0005 A 0:MULTIPLY_INT64_CONSTANT                              2   0   0    ; const = 10
0006 S 0:SUBTRACT_COMPLEX128                                  3   0   1
0007 A 1:IMAGINARY_PART_COMPLEX128                           10   1   3
0008 A 1:CONVERT_FLOAT64_TO_INT64                            51   3   1
0009 A 0:ADD_INT64                                            0   2   3
0010 A 2:RETURN                                               0  10   1    ; 1 values
