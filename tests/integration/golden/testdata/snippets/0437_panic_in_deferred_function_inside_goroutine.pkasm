0003 S 0:TYPE_ASSERT                                          1   0   0
0004   0:EXTENSION                                            0   0   0
0005 S 0:UNBOX_FROM_INTERFACE                                 0   1   2
0006 A 0:JUMP_IF_FALSE                                        0   3   0    ; if ints[0] == 0 goto +3
0007 A 0:GET_CAPTURED_VARIABLE                                2   0   3
0008 G 0:SEND_TO_CHANNEL                                      2   0   2
0009 A 3:RETURN_VOID                                          0   0   1
