; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=1 string=2 general=2
;   dispatch:  asm=5 shim=1 exit=0 go=4
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=0
;   strings: [0]="inner"

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0001 G 1:MAKE_CHANNEL                                        80   0   0
0002   0:EXTENSION                                            0   0   0
0003 S 0:MAKE_CLOSURE                                         1   1   0    ; closure (func 1)
0004 G 0:GO                                                   1   0   0
0005 G 1:RECEIVE_FROM_CHANNEL                                82   0   0
0006   0:EXTENSION                                            0   2   0
0007 G 1:EQUAL_STRING_CONSTANT_THEN_JUMP_IF_FALSE           136   0   0
0008   0:EXTENSION                                            2   0   0
0009 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0010 A 2:RETURN                                               0  10   1    ; 1 values
0011 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0012 A 2:RETURN                                               0  10   1    ; 1 values

