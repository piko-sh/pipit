;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=0
;   strings: [0]="inner"

0000 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0001 G 1:MAKE_CHANNEL              80   0   0
0002   0:EXT                        0   0   0
0003 S 0:MAKE_CLOSURE               1   1   0    ; closure (func 1)
0004 G 0:GO                         1   0   0
0005 G 1:CHANNEL_RECEIVE           82   0   0
0006   0:EXT                        0   2   0
0007 G 1:EQ_STRING_CONST_JUMP_FALSE 136   0   0
0008   0:EXT                        3   0   0
0009 G 3:TIER3_NOP                  0   0   0
0010 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0011 A 2:TIER2_RETURN               0  10   1    ; 1 values
0012 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0013 A 2:TIER2_RETURN               0  10   1    ; 1 values

