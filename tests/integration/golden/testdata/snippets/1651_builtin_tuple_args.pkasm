; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function pair
;   registers: string=1 general=3 sliceByte=2
;   dispatch:  asm=4 shim=2 exit=0 go=1
;   params:    (general)
;   returns:   (sliceByte, sliceByte)
; ═════════════════════════════════════════════════════════════

; constants:
;   strings: [0]="xyz"

0000 A 0:MOVE_GENERAL                                         1   0   1
0001 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "xyz"
0002 G 1:CONVERT_STRING_TO_BYTES                             71   2   0
0003 A 0:MOVE_GENERAL                                         2   2   1
0004 S 1:UNBOX_SLICE_BYTE                                   160   0   1
0005 S 1:UNBOX_SLICE_BYTE                                   160   1   2
0006 A 2:RETURN                                               0  10   2    ; 2 values

; ═════════════════════════════════════════════════════════════
; function mixed
;   registers: string=2 general=2 sliceByte=1
;   dispatch:  asm=3 shim=1 exit=0 go=0
;   params:    (general)
;   returns:   (sliceByte, string)
; ═════════════════════════════════════════════════════════════

; constants:
;   strings: [0]="hello"

0000 A 0:MOVE_GENERAL                                         1   0   1
0001 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "hello"
0002 S 1:UNBOX_SLICE_BYTE                                   160   0   1
0003 A 2:RETURN                                               0  10   2    ; 2 values

