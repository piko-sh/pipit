; constants:
;   ints:    [0]=1

0000 A 0:MOVE_GENERAL                                         1   0   1
0001 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0002 A 0:MOVE_GENERAL                                         0   1   0
0003 A 2:RETURN                                               0  10   2    ; 2 values

; ═════════════════════════════════════════════════════════════
; function parts
;   registers: float64=4
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (float64, float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   floats:  [0]=1.5  [1]=-2

0000 A 0:LOAD_FLOAT64_CONSTANT                                0   0   0    ; floats[0] = 1.5
0001 A 0:LOAD_FLOAT64_CONSTANT                                1   1   0    ; floats[1] = -2
0002 A 2:RETURN                                               0  10   2    ; 2 values

