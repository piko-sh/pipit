; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4 string=4
;   dispatch:  asm=8 shim=4 exit=0 go=0
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=48
;   strings: [0]="ab"  [1]="ababab"  [2]=":"

0000 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "ab"
0001 A 1:LOAD_INT64_IMMEDIATE                                75   0   3    ; ints[0] = 3
0002 S 0:STRINGS_REPEAT                                       0   0   0
0003 A 0:LOAD_STRING_CONSTANT                                 1   1   0    ; strings[1] = "ababab"
0004 A 0:LOAD_STRING_CONSTANT                                 2   0   0    ; strings[2] = "ab"
0005 S 0:STRINGS_COUNT                                        0   1   2
0006 A 0:LOAD_STRING_CONSTANT                                 1   2   0    ; strings[1] = ":"
0007 S 0:CONCATENATE_STRING                                   2   0   1
0008 A 1:LOAD_INT64_IMMEDIATE                                75   1  48    ; ints[1] = 48
0009 A 0:ADD_INT32                                            3   1   0
0010 S 0:CONCATENATE_STRING_RUNE                              0   2   3
0011 A 2:RETURN                                               0  10   1    ; 1 values
