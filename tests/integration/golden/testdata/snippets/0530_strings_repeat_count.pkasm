; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=4 string=4
;   dispatch:  asm=11 shim=4 exit=0 go=1
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=48
;   strings: [0]="ab"  [1]="ababab"  [2]=":"

0000 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "ab"
0001 A 1:LOAD_INT_CONST_SMALL      75   0   3    ; ints[0] = 3
0002 S 0:STR_REPEAT                 1   0   0
0003 A 1:MOVE_STRING               37   0   1
0004 A 0:LOAD_STRING_CONST          1   1   0    ; strings[1] = "ababab"
0005 A 0:LOAD_STRING_CONST          2   0   0    ; strings[2] = "ab"
0006 S 0:STR_COUNT                  0   1   2
0007 A 0:LOAD_STRING_CONST          1   2   0    ; strings[1] = ":"
0008 S 0:CONCAT_STRING              2   0   1
0009 A 1:LOAD_INT_CONST_SMALL      75   1  48    ; ints[1] = 48
0010 A 0:ADD_INT                    2   1   0
0011 A 1:MOVE_INT                  35   3   2
0012 A 0:TRUNCATE_NARROW            3  32   0
0013 S 0:CONCAT_RUNE_STRING         0   2   3
0014 G 3:TIER3_NOP                  0   0   0
0015 A 2:TIER2_RETURN               0  10   1    ; 1 values
