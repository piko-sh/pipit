; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function <varinit>
;   registers: uint64=1
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; constants:
;   uints:   [0]=7

0000 A 0:LOAD_UINT64_CONSTANT                                 0   0   0
0001 A 0:SET_GLOBAL                                           0   0   5
0002 A 3:RETURN_VOID                                          0   0   1

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=1 float64=3 uint64=1
;   dispatch:  asm=7 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   floats:  [0]=3

0000 A 0:GET_GLOBAL                                           0   0   5
0001 A 1:CONVERT_UINT64_TO_FLOAT64                           57   0   0
0002 A 0:LOAD_FLOAT64_CONSTANT                                1   0   0    ; floats[1] = 3
0003 A 0:MULTIPLY_FLOAT64                                     2   0   1
0004 A 1:CONVERT_FLOAT64_TO_UINT64                           58   0   2
0005 A 1:CONVERT_UINT64_TO_INT64                             56   0   0
0006 A 2:RETURN                                               0  10   1    ; 1 values
