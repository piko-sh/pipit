; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2 string=6
;   dispatch:  asm=12 shim=4 exit=0 go=0
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=255  [1]=16  [2]=8  [3]=2  [4]=-42  [5]=10
;   strings: [0]="|"

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0 255    ; ints[0] = 255
0001 A 1:LOAD_INT64_IMMEDIATE                                75   1  16    ; ints[1] = 16
0002 A 1:STRCONV_FORMAT_INT                                   7   0   0
0003   0:EXTENSION                                            1   0   0
0004 A 1:LOAD_INT64_IMMEDIATE                                75   0   8    ; ints[0] = 8
0005 A 1:LOAD_INT64_IMMEDIATE                                75   1   2    ; ints[1] = 2
0006 A 1:STRCONV_FORMAT_INT                                   7   1   0
0007   0:EXTENSION                                            1   0   0
0008 A 0:LOAD_INT64_CONSTANT                                  0   4   0    ; ints[0] = -42
0009 A 1:LOAD_INT64_IMMEDIATE                                75   1  10    ; ints[1] = 10
0010 A 1:STRCONV_FORMAT_INT                                   7   2   0
0011   0:EXTENSION                                            1   0   0
0012 A 0:LOAD_STRING_CONSTANT                                 3   0   0    ; strings[3] = "|"
0013 S 0:CONCATENATE_STRING                                   4   0   3
0014 S 0:CONCATENATE_STRING                                   4   4   1
0015 A 0:LOAD_STRING_CONSTANT                                 5   0   0    ; strings[5] = "|"
0016 S 0:CONCATENATE_STRING                                   4   4   5
0017 S 0:CONCATENATE_STRING                                   0   4   2
0018 A 2:RETURN                                               0  10   1    ; 1 values
