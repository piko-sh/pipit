; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: string=7
;   dispatch:  asm=11 shim=9 exit=0 go=1
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   strings: [0]="  hello  "  [1]="foo-bar"  [2]="foo-"  [3]="-bar"  [4]="##hi##"  [5]="#"  [6]="|"

0000 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "  hello  "
0001 G 1:STRINGS_TRIM_SPACE                                  69   0   0
0002 A 0:LOAD_STRING_CONSTANT                                 1   1   0    ; strings[1] = "foo-bar"
0003 A 0:LOAD_STRING_CONSTANT                                 2   2   0    ; strings[2] = "foo-"
0004 S 0:STRINGS_TRIM_PREFIX                                  1   1   2
0005 A 0:LOAD_STRING_CONSTANT                                 2   1   0    ; strings[2] = "foo-bar"
0006 A 0:LOAD_STRING_CONSTANT                                 3   3   0    ; strings[3] = "-bar"
0007 S 0:STRINGS_TRIM_SUFFIX                                  2   2   3
0008 A 0:LOAD_STRING_CONSTANT                                 3   4   0    ; strings[3] = "##hi##"
0009 A 0:LOAD_STRING_CONSTANT                                 4   5   0    ; strings[4] = "#"
0010 S 0:STRINGS_TRIM                                         3   3   4
0011 A 0:LOAD_STRING_CONSTANT                                 4   6   0    ; strings[4] = "|"
0012 S 0:CONCATENATE_STRING                                   5   0   4
0013 S 0:CONCATENATE_STRING                                   5   5   1
0014 A 0:LOAD_STRING_CONSTANT                                 6   6   0    ; strings[6] = "|"
0015 S 0:CONCATENATE_STRING                                   5   5   6
0016 S 0:CONCATENATE_STRING                                   5   5   2
0017 A 0:LOAD_STRING_CONSTANT                                 6   6   0    ; strings[6] = "|"
0018 S 0:CONCATENATE_STRING                                   5   5   6
0019 S 0:CONCATENATE_STRING                                   0   5   3
0020 A 2:RETURN                                               0  10   1    ; 1 values
