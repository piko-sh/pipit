; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: string=7
;   dispatch:  asm=12 shim=9 exit=0 go=1
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   strings: [0]="  hello  "  [1]="foo-bar"  [2]="foo-"  [3]="-bar"  [4]="##hi##"  [5]="#"  [6]="|"

0000 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "  hello  "
0001 G 1:STR_TRIM_SPACE            69   1   0
0002 A 1:MOVE_STRING               37   0   1
0003 A 0:LOAD_STRING_CONST          1   1   0    ; strings[1] = "foo-bar"
0004 A 0:LOAD_STRING_CONST          2   2   0    ; strings[2] = "foo-"
0005 S 0:STR_TRIM_PREFIX            1   1   2
0006 A 0:LOAD_STRING_CONST          2   1   0    ; strings[2] = "foo-bar"
0007 A 0:LOAD_STRING_CONST          3   3   0    ; strings[3] = "-bar"
0008 S 0:STR_TRIM_SUFFIX            2   2   3
0009 A 0:LOAD_STRING_CONST          3   4   0    ; strings[3] = "##hi##"
0010 A 0:LOAD_STRING_CONST          4   5   0    ; strings[4] = "#"
0011 S 0:STR_TRIM                   3   3   4
0012 A 0:LOAD_STRING_CONST          4   6   0    ; strings[4] = "|"
0013 S 0:CONCAT_STRING              5   0   4
0014 S 0:CONCAT_STRING              5   5   1
0015 A 0:LOAD_STRING_CONST          6   6   0    ; strings[6] = "|"
0016 S 0:CONCAT_STRING              5   5   6
0017 S 0:CONCAT_STRING              5   5   2
0018 A 0:LOAD_STRING_CONST          6   6   0    ; strings[6] = "|"
0019 S 0:CONCAT_STRING              5   5   6
0020 S 0:CONCAT_STRING              0   5   3
0021 A 2:TIER2_RETURN               0  10   1    ; 1 values
