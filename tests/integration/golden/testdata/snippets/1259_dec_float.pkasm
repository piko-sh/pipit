; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: float64=2
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   floats:  [0]=3.5  [1]=1

0000 A 0:LOAD_FLOAT64_CONSTANT                                0   0   0    ; floats[0] = 3.5
0001 A 0:LOAD_FLOAT64_CONSTANT                                1   1   0    ; floats[1] = 1
0002 A 0:SUBTRACT_FLOAT64                                     0   0   1
0003 A 2:RETURN                                               0  10   1    ; 1 values
