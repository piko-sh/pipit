; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function sumTo
;   registers: int64=2 general=5
;   dispatch:  asm=9 shim=4 exit=0 go=2
;   params:    (general)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=1

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0001 S 0:BOX_AS_INTERFACE                                     1   0   0
0002 S 0:LESS_OR_EQUAL_GENERAL                                1   0   1
0003 A 0:JUMP_IF_FALSE                                        1   4   0    ; if ints[1] == 0 goto +4
0004 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0005 S 0:BOX_AS_INTERFACE                                     1   0   0
0006 A 0:MOVE_GENERAL                                         0   1   0
0007 A 2:RETURN                                               0  10   1    ; 1 values
0008 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0009 S 0:BOX_AS_INTERFACE                                     1   0   0
0010 G 0:SUBTRACT_GENERAL                                     2   0   1
0011 A 1:CALL                                               128   0   0    ; call (site 0)
0012 G 0:ADD_GENERAL                                          4   0   3
0013 A 0:MOVE_GENERAL                                         0   4   0
0014 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=10

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0  10    ; ints[0] = 10
0001 A 1:CALL_SCALAR                                        134   0   0
0002 A 1:MOVE_INT64                                          35   0   1
0003 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function sumTo[spec:int]
;   registers: int64=4
;   dispatch:  asm=7 shim=0 exit=0 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=1

0000 A 1:LESS_OR_EQUAL_INT64_CONSTANT_THEN_JUMP_IF_FALSE    122   0   0
0001   0:EXTENSION                                            2   0   0
0002 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0003 A 2:RETURN                                               0  10   1    ; 1 values
0004 A 0:SUBTRACT_INT64_CONSTANT                              2   0   1    ; const = 1
0005 A 1:CALL_SCALAR                                        134   0   0
0006 A 0:ADD_INT64                                            0   0   3
0007 A 2:RETURN                                               0  10   1    ; 1 values
