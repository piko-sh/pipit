; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function sumTo
;   registers: int=2 general=5
;   dispatch:  asm=9 shim=4 exit=0 go=2
;   params:    (general)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=1

0000 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0001 S 0:PACK_INTERFACE             1   0   0
0002 S 0:LE_GENERAL                 1   0   1
0003 A 0:JUMP_IF_FALSE              1   4   0    ; if ints[1] == 0 goto +4
0004 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0005 S 0:PACK_INTERFACE             1   0   0
0006 A 0:MOVE_GENERAL               0   1   0
0007 A 2:TIER2_RETURN               0  10   1    ; 1 values
0008 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0009 S 0:PACK_INTERFACE             1   0   0
0010 G 0:SUB                        2   0   1
0011 A 1:CALL                     128   0   0    ; call (site 0)
0012 G 0:ADD                        4   0   3
0013 A 0:MOVE_GENERAL               0   4   0
0014 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=2
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=10

0000 A 1:LOAD_INT_CONST_SMALL      75   0  10    ; ints[0] = 10
0001 A 1:CALL_SCALAR              134   0   0
0002 A 1:MOVE_INT                  35   0   1
0003 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function sumTo[spec:int]
;   registers: int=4
;   dispatch:  asm=9 shim=0 exit=0 go=1
;   params:    (int)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=1

0000 A 1:LE_INT_CONST_JUMP_FALSE  122   0   0
0001   0:EXT                        4   0   0
0002 G 3:TIER3_NOP                  0   0   0
0003 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0004 A 1:MOVE_INT                  35   0   1
0005 A 2:TIER2_RETURN               0  10   1    ; 1 values
0006 A 1:LOAD_INT_CONST_SMALL      75   1   1    ; ints[1] = 1
0007 A 0:SUB_INT                    2   0   1
0008 A 1:CALL_SCALAR              134   0   0
0009 A 0:ADD_INT                    0   0   3
0010 A 2:TIER2_RETURN               0  10   1    ; 1 values
