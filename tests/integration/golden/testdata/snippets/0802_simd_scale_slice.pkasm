0013 A 1:JUMP                      74 247 255    ; goto -9
0014 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 2.5
0015 A 1:LEN_SLICE_FLOAT_DIRECT    21   1   0
0016 G 1:SIMD_SCALE_SLICE_FLOAT64 154   0   0
0017   0:EXT                        1   0   0
