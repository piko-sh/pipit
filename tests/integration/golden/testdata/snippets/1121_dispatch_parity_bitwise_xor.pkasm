; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=3
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=255  [1]=15

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0 255    ; ints[0] = 255
0001 A 1:LOAD_INT64_IMMEDIATE                                75   1  15    ; ints[1] = 15
0002 A 0:BIT_XOR_INT64                                        0   0   1
0003 A 2:RETURN                                               0  10   1    ; 1 values
