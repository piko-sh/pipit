; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=2 string=1
;   dispatch:  asm=4 shim=1 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=108
;   strings: [0]="hello"

0000 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "hello"
0001 A 1:LOAD_INT_CONST_SMALL      75   0 108    ; ints[0] = 108
0002 S 0:STR_INDEX_RUNE             1   0   0
0003 A 1:MOVE_INT                  35   0   1
0004 A 2:TIER2_RETURN               0  10   1    ; 1 values
