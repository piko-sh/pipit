; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2 string=1
;   dispatch:  asm=3 shim=1 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=108
;   strings: [0]="hello"

0000 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "hello"
0001 A 1:LOAD_INT64_IMMEDIATE                                75   0 108    ; ints[0] = 108
0002 S 0:STRINGS_INDEX_RUNE                                   0   0   0
0003 A 2:RETURN                                               0  10   1    ; 1 values
