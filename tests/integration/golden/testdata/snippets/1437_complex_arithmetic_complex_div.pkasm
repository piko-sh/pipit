; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: complex128=3
;   dispatch:  asm=3 shim=3 exit=0 go=0
;   params:    (none)
;   returns:   (complex128)
; ═════════════════════════════════════════════════════════════

; constants:
;   complex: [0]=(2+4i)

0000 S 0:LOAD_COMPLEX128_CONSTANT                             1   0   0
0001 A 1:MOVE_COMPLEX128                                     15   0   1
0002 S 0:LOAD_COMPLEX128_CONSTANT                             2   0   0
0003 A 1:MOVE_COMPLEX128                                     15   1   2
0004 S 0:DIVIDE_COMPLEX128                                    0   0   1
0005 A 2:RETURN                                               0  10   1    ; 1 values
