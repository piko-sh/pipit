; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=1 uint64=4
;   dispatch:  asm=10 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=0
;   uints:   [0]=5  [1]=10  [2]=1000

0000 A 1:LOAD_UINT64_IMMEDIATE                               99   0   5    ; uints[0] = 5
0001 A 1:LOAD_UINT64_IMMEDIATE                               99   1  10    ; uints[1] = 10
0002 A 0:SUBTRACT_UINT64                                      2   0   1
0003 A 0:LOAD_UINT64_CONSTANT                                 3   2   0
0004 A 0:GREATER_THAN_UINT64                                  0   2   3
0005 A 0:JUMP_IF_FALSE                                        0   2   0    ; if ints[0] == 0 goto +2
0006 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0007 A 2:RETURN                                               0  10   1    ; 1 values
0008 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0009 A 2:RETURN                                               0  10   1    ; 1 values
