0001   0:EXT                        0   0   0
0002 G 2:MAKE_MAP                   0  12   1
0003   0:EXT                        1   0   0
0004 A 0:SET_STRUCT_FIELD_GENERAL_T0   0   1   0
0005 S 0:ADDR                       1   0   0
0006 A 0:MOVE_GENERAL               0   1   0
0007 A 2:TIER2_RETURN               0  10   1    ; 1 values

