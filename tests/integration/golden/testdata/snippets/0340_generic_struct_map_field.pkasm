0006 A 0:MOVE_GENERAL                                         0   2   0
0007 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "answer"
0008 A 1:LOAD_INT64_IMMEDIATE                                75   0  42    ; ints[0] = 42
0009 A 1:CALL                                               128   1   0    ; call (site 1)
0010 A 0:LOAD_STRING_CONSTANT                                 0   1   0    ; strings[0] = "year"
0011 A 0:LOAD_INT64_CONSTANT                                  0   1   0    ; ints[0] = 2026
0012 A 1:CALL                                               128   2   0    ; call (site 2)
0013 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "answer"
0014 A 1:CALL                                               128   3   0    ; call (site 3)
0015 A 0:LOAD_STRING_CONSTANT                                 1   1   0    ; strings[1] = "year"
0016 A 1:CALL                                               128   4   0    ; call (site 4)
0017 A 0:ADD_INT64                                            0   0   1
0018 A 2:RETURN                                               0  10   1    ; 1 values

