0002 G 0:PACK_TYPED                 1   0   2
0003   0:EXT                        0   0   0
0004 A 1:LOAD_INT_CONST_SMALL      75   0  42    ; ints[0] = 42
0005 G 0:PACK_TYPED                 2   0   0
0006   0:EXT                        1   0   0
0007 X 0:GET_FIELD                  5   0   0    ; inlined body of function 1 called at PC 7
0008 S 0:MAP_SET                    5   1   2
0009 A 0:LOAD_STRING_CONST          0   1   0    ; strings[0] = "year"
0010 G 0:PACK_TYPED                 1   0   2
0011   0:EXT                        0   0   0
0012 A 0:LOAD_INT_CONST             0   1   0    ; ints[0] = 2026
0013 G 0:PACK_TYPED                 2   0   0
0014   0:EXT                        1   0   0
0015 X 0:GET_FIELD                  6   0   0    ; inlined body of function 1 called at PC 15
0016 S 0:MAP_SET                    6   1   2
0017 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "answer"
0018 G 0:PACK_TYPED                 1   0   2
0019   0:EXT                        0   0   0
0020 A 1:CALL                     128   3   0    ; call (site 3)
0021 S 0:UNPACK_INTERFACE           0   2   0
0022 A 0:LOAD_STRING_CONST          1   1   0    ; strings[1] = "year"
0023 G 0:PACK_TYPED                 3   1   2
0024   0:EXT                        0   0   0
0025 A 1:CALL                     128   4   0    ; call (site 4)
0026 S 0:UNPACK_INTERFACE           1   4   0
0027 A 0:ADD_INT                    0   0   1
0028 A 2:TIER2_RETURN               0  10   1    ; 1 values

