; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=42  [1]=2026
;   strings: [0]="answer"  [1]="year"

0000 S 2:MAKE_MAP                                             0  12   0    ; inlined body of function 4 called at PC 0
0001   0:EXTENSION                                            0   0   0
0002 S 2:MAKE_MAP                                             0  12   2
0003   0:EXTENSION                                            1   0   0
0004 A 0:SET_STRUCT_FIELD_GENERAL                             0   2   0
