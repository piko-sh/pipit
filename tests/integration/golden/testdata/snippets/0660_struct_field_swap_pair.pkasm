; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function swap
;   registers: general=1
;   dispatch:  asm=1 shim=1 exit=0 go=0
;   params:    (general)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

0000 S 0:SWAP_STRUCT_FIELDS_GENERAL                           0   0   1
0001 A 3:RETURN_VOID                                          0   0   1

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4 general=5
;   dispatch:  asm=18 shim=7 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=2  [2]=10

0000 A 2:ALLOCATE_STRUCT_LITERAL                              0  14   0
0001   0:EXTENSION                                            0   0   0
0002 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0003 A 0:SET_STRUCT_FIELD_INT64                               0   0   0
0004 S 0:ADDRESS                                              1   0   0
0005 A 0:MOVE_GENERAL                                         0   1   1
0006 A 2:ALLOCATE_STRUCT_LITERAL                              0  14   1
0007   0:EXTENSION                                            0   0   0
0008 A 1:LOAD_INT64_IMMEDIATE                                75   0   2    ; ints[0] = 2
0009 A 0:SET_STRUCT_FIELD_INT64                               1   0   0
0010 S 0:ADDRESS                                              2   1   0
0011 A 0:MOVE_GENERAL                                         1   2   1
0012 S 2:MAKE_MAP                                             0  12   2
0013   0:EXTENSION                                            1   0   0
0014 A 0:SET_STRUCT_FIELD_GENERAL                             2   0   1
0015 A 0:SET_STRUCT_FIELD_GENERAL                             2   1   2
0016 S 0:ADDRESS                                              3   2   0
0017 A 0:MOVE_GENERAL                                         2   3   1
0018 S 0:SWAP_STRUCT_FIELDS_GENERAL                           2   1   2    ; inlined body of function 0 called at PC 18
0019 S 0:SWAP_STRUCT_FIELDS_GENERAL                           2   1   2    ; inlined body of function 0 called at PC 19
0020 S 0:SWAP_STRUCT_FIELDS_GENERAL                           2   1   2    ; inlined body of function 0 called at PC 20
0021 A 0:GET_STRUCT_FIELD_GENERAL                             3   2   1
0022 A 0:GET_STRUCT_FIELD_INT64                               0   3   0
0023 A 0:MULTIPLY_INT64_CONSTANT                              2   0   2    ; const = 10
0024 A 0:GET_STRUCT_FIELD_GENERAL                             4   2   2
0025 A 0:GET_STRUCT_FIELD_INT64                               3   4   0
0026 A 0:ADD_INT64                                            0   2   3
0027 A 2:RETURN                                               0  10   1    ; 1 values
