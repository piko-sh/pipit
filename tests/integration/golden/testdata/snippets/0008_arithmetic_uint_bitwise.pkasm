; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function <varinit>
;   registers: uint=1
;   dispatch:  asm=3 shim=2 exit=0 go=0
;   params:    (none)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; constants:
;   uints:   [0]=255  [1]=15

0000 A 0:LOAD_UINT_CONST            0   0   0
0001 S 0:SET_GLOBAL                 0   0   5
0002 A 0:LOAD_UINT_CONST            0   1   0
0003 S 0:SET_GLOBAL                 0   1   5
0004 A 3:TIER3_RETURN_VOID          0   0   1

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=6 uint=12
;   dispatch:  asm=8 shim=8 exit=0 go=4
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

0000 S 0:GET_GLOBAL                 0   0   5
0001 S 0:GET_GLOBAL                 1   1   5
0002 A 0:BIT_AND_UINT               2   0   1
0003 G 1:UINT_TO_INT               56   0   2
0004 S 0:GET_GLOBAL                 3   0   5
0005 S 0:GET_GLOBAL                 4   1   5
0006 A 0:BIT_OR_UINT                5   3   4
0007 G 1:UINT_TO_INT               56   1   5
0008 A 0:ADD_INT                    2   0   1
0009 S 0:GET_GLOBAL                 6   0   5
0010 S 0:GET_GLOBAL                 7   1   5
0011 A 0:BIT_XOR_UINT               8   6   7
0012 G 1:UINT_TO_INT               56   3   8
0013 A 0:ADD_INT                    4   2   3
0014 S 0:GET_GLOBAL                 9   0   5
0015 S 0:GET_GLOBAL                10   1   5
0016 A 0:BIT_AND_NOT_UINT          11   9  10
0017 G 1:UINT_TO_INT               56   5  11
0018 A 0:ADD_INT                    0   4   5
0019 A 2:TIER2_RETURN               0  10   1    ; 1 values
