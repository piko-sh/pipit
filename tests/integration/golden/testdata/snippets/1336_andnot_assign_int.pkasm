; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=3
;   dispatch:  asm=5 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=255  [1]=15

0000 A 1:LOAD_INT_CONST_SMALL      75   0 255    ; ints[0] = 255
0001 A 1:LOAD_INT_CONST_SMALL      75   1  15    ; ints[1] = 15
0002 A 0:BIT_AND_NOT                2   0   1
0003 A 1:MOVE_INT                  35   0   2
0004 A 2:TIER2_RETURN               0  10   1    ; 1 values
