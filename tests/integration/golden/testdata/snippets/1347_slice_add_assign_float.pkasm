; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=1 float=3 general=2
;   dispatch:  asm=10 shim=6 exit=0 go=2
;   params:    (none)
;   returns:   (float)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=2  [1]=0  [2]=1
;   floats:  [0]=1.5  [1]=2.5  [2]=3.5

0000 A 1:LOAD_INT_CONST_SMALL      75   0   2    ; ints[0] = 2
0001 S 0:MAKE_SLICE                 0   0   0
0002   0:EXT                        0   0   0
0003 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 1.5
0004 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0005 G 1:MOVE_FLOAT_TO_GENERAL     42   1   0
0006 S 0:INDEX_SET                  0   0   1
0007 A 0:LOAD_FLOAT_CONST           0   1   0    ; floats[0] = 2.5
0008 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0009 G 1:MOVE_FLOAT_TO_GENERAL     42   1   0
0010 S 0:INDEX_SET                  0   0   1
0011 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0012 A 0:LOAD_FLOAT_CONST           0   2   0    ; floats[0] = 3.5
0013 S 0:SLICE_GET_FLOAT            1   0   0
0014 A 0:ADD_FLOAT                  2   1   0
0015 S 0:SLICE_SET_FLOAT            0   0   2
0016 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0017 S 0:SLICE_GET_FLOAT            0   0   0
0018 A 2:TIER2_RETURN               0  10   1    ; 1 values
