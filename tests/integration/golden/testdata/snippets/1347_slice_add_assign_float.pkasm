; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=1 float64=3 general=2
;   dispatch:  asm=10 shim=8 exit=0 go=0
;   params:    (none)
;   returns:   (float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=2  [1]=0  [2]=1
;   floats:  [0]=1.5  [1]=2.5  [2]=3.5

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   2    ; ints[0] = 2
0001 S 0:MAKE_SLICE                                           0   0   0
0002   0:EXTENSION                                            0   0   0
0003 A 0:LOAD_FLOAT64_CONSTANT                                0   0   0    ; floats[0] = 1.5
0004 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0005 S 1:BOX_FLOAT64                                         42   1   0
0006 S 0:SET_ELEMENT                                          0   0   1
0007 A 0:LOAD_FLOAT64_CONSTANT                                0   1   0    ; floats[0] = 2.5
0008 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0009 S 1:BOX_FLOAT64                                         42   1   0
0010 S 0:SET_ELEMENT                                          0   0   1
0011 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0012 A 0:LOAD_FLOAT64_CONSTANT                                0   2   0    ; floats[0] = 3.5
0013 S 0:GET_ELEMENT_FLOAT64                                  1   0   0
0014 A 0:ADD_FLOAT64                                          2   1   0
0015 S 0:SET_ELEMENT_FLOAT64                                  0   0   2
0016 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0017 S 0:GET_ELEMENT_FLOAT64                                  0   0   0
0018 A 2:RETURN                                               0  10   1    ; 1 values
