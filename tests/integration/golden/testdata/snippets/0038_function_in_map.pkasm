; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function inc
;   registers: int64=2
;   dispatch:  asm=2 shim=0 exit=0 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1

0000 A 0:ADD_INT64_CONSTANT                                   0   0   0    ; const = 1
0001 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function dec
;   registers: int64=2
;   dispatch:  asm=2 shim=0 exit=0 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1

0000 A 0:SUBTRACT_INT64_CONSTANT                              0   0   0    ; const = 1
0001 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4 string=2 general=3
;   dispatch:  asm=8 shim=9 exit=0 go=2
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=20
;   strings: [0]="inc"  [1]="dec"

0000 S 2:MAKE_MAP                                             0  12   0
0001   0:EXTENSION                                            0   0   1
0002 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "inc"
0003 S 0:MAKE_CLOSURE                                         1   0   0    ; closure (func 0)
0004 S 1:BOX_STRING                                          44   2   0
0005 S 0:SET_MAP                                              0   2   1
0006 A 0:LOAD_STRING_CONSTANT                                 0   1   0    ; strings[0] = "dec"
0007 S 0:MAKE_CLOSURE                                         1   1   0    ; closure (func 1)
0008 S 1:BOX_STRING                                          44   2   0
0009 S 0:SET_MAP                                              0   2   1
0010 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "inc"
0011 S 0:GET_MAP_STRING_GENERAL                               1   0   0
0012 A 1:LOAD_INT64_IMMEDIATE                                75   0  20    ; ints[0] = 20
0013 G 1:CALL_NATIVE                                        130   0   0    ; call native general[1] (site 0)
0014 A 0:LOAD_STRING_CONSTANT                                 1   1   0    ; strings[1] = "dec"
0015 S 0:GET_MAP_STRING_GENERAL                               2   0   1
0016 A 1:LOAD_INT64_IMMEDIATE                                75   2  20    ; ints[2] = 20
0017 G 1:CALL_NATIVE                                        130   1   0    ; call native general[2] (site 1)
0018 A 0:ADD_INT64                                            0   1   3
0019 A 2:RETURN                                               0  10   1    ; 1 values
