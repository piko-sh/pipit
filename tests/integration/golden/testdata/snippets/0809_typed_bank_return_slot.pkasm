; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function makeInts
;   registers: int=2 general=1 sliceInt=1
;   dispatch:  asm=6 shim=1 exit=3 go=1
;   params:    (none)
;   returns:   (sliceInt)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=3  [2]=1  [3]=2

0000 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT_CONST_SMALL      75   1   3    ; ints[1] = 3
0002 S 0:MAKE_SLICE                 0   0   1
0003   0:EXT                        0   0   1
0004 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0005 X 0:APPEND_INT_FAST            0   0   0
0006 A 1:LOAD_INT_CONST_SMALL      75   0   2    ; ints[0] = 2
0007 X 0:APPEND_INT_FAST            0   0   0
0008 A 1:LOAD_INT_CONST_SMALL      75   0   3    ; ints[0] = 3
0009 X 0:APPEND_INT_FAST            0   0   0
0010 G 1:ADOPT_GENERAL_TO_SLICES_INT 156   0   0
0011 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function makeFloats
;   registers: int=1 float=1 general=2 sliceFloat=1
;   dispatch:  asm=8 shim=4 exit=0 go=4
;   params:    (none)
;   returns:   (sliceFloat)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=0  [2]=1  [3]=2
;   floats:  [0]=1.5  [1]=2.5  [2]=3.5

0000 A 1:LOAD_INT_CONST_SMALL      75   0   3    ; ints[0] = 3
0001 S 0:MAKE_SLICE                 0   0   0
0002   0:EXT                        0   0   0
0003 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 1.5
0004 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0005 G 1:MOVE_FLOAT_TO_GENERAL     42   1   0
0006 S 0:INDEX_SET                  0   0   1
0007 A 0:LOAD_FLOAT_CONST           0   1   0    ; floats[0] = 2.5
0008 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0009 G 1:MOVE_FLOAT_TO_GENERAL     42   1   0
0010 S 0:INDEX_SET                  0   0   1
0011 A 0:LOAD_FLOAT_CONST           0   2   0    ; floats[0] = 3.5
0012 A 1:LOAD_INT_CONST_SMALL      75   0   2    ; ints[0] = 2
0013 G 1:MOVE_FLOAT_TO_GENERAL     42   1   0
0014 S 0:INDEX_SET                  0   0   1
0015 G 1:ADOPT_GENERAL_TO_SLICES_FLOAT 155   0   0
0016 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function toBytes
;   registers: string=1 general=1 sliceByte=1
;   dispatch:  asm=1 shim=0 exit=0 go=2
;   params:    (string)
;   returns:   (sliceByte)
; ═════════════════════════════════════════════════════════════

0000 G 1:STRING_TO_BYTES           71   0   0
0001 G 1:ADOPT_GENERAL_TO_SLICES_BYTE 160   0   0
0002 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function makeStrings
;   registers: int=1 string=1 general=2 sliceString=1
;   dispatch:  asm=8 shim=4 exit=0 go=4
;   params:    (none)
;   returns:   (sliceString)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=0  [2]=1  [3]=2
;   strings: [0]="a"  [1]="bb"  [2]="ccc"

0000 A 1:LOAD_INT_CONST_SMALL      75   0   3    ; ints[0] = 3
0001 S 0:MAKE_SLICE                 0   0   0
0002   0:EXT                        0   0   0
0003 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "a"
0004 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0005 G 1:MOVE_STRING_TO_GENERAL    44   1   0
0006 S 0:INDEX_SET                  0   0   1
0007 A 0:LOAD_STRING_CONST          0   1   0    ; strings[0] = "bb"
0008 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0009 G 1:MOVE_STRING_TO_GENERAL    44   1   0
0010 S 0:INDEX_SET                  0   0   1
0011 A 0:LOAD_STRING_CONST          0   2   0    ; strings[0] = "ccc"
0012 A 1:LOAD_INT_CONST_SMALL      75   0   2    ; ints[0] = 2
0013 G 1:MOVE_STRING_TO_GENERAL    44   1   0
0014 S 0:INDEX_SET                  0   0   1
0015 G 1:ADOPT_GENERAL_TO_SLICES_STRING 157   0   0
0016 A 2:TIER2_RETURN               0  10   1    ; 1 values

