; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2 string=1 general=3
;   dispatch:  asm=12 shim=12 exit=0 go=1
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=2  [2]=3  [3]=99
;   strings: [0]="a"  [1]="b"  [2]="c"  [3]="x"

0000 S 2:MAKE_MAP                                             0  12   0
0001   0:EXTENSION                                            0   0   2
0002 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "a"
0003 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0004 S 1:BOX_STRING                                          44   1   0
0005 S 1:BOX_INT64                                           40   2   0
0006 S 0:SET_MAP                                              0   1   2
0007 A 0:LOAD_STRING_CONSTANT                                 0   1   0    ; strings[0] = "b"
0008 A 1:LOAD_INT64_IMMEDIATE                                75   0   2    ; ints[0] = 2
0009 S 1:BOX_STRING                                          44   1   0
0010 S 1:BOX_INT64                                           40   2   0
0011 S 0:SET_MAP                                              0   1   2
0012 A 0:LOAD_STRING_CONSTANT                                 0   2   0    ; strings[0] = "c"
0013 A 1:LOAD_INT64_IMMEDIATE                                75   0   3    ; ints[0] = 3
0014 S 1:BOX_STRING                                          44   1   0
0015 S 1:BOX_INT64                                           40   2   0
0016 S 0:SET_MAP                                              0   1   2
0017 G 1:CALL_BUILTIN                                       131   3   1    ; call builtin
0018   0:EXTENSION                                            0   3   0
0019 A 1:LOAD_INT64_IMMEDIATE                                75   0  99    ; ints[0] = 99
0020 A 0:LOAD_STRING_CONSTANT                                 0   3   0    ; strings[0] = "x"
0021 S 0:SET_MAP_STRING_INT64                                 0   0   0
0022 A 1:LENGTH_GENERAL                                      70   0   0
0023 A 0:LOAD_STRING_CONSTANT                                 0   3   0    ; strings[0] = "x"
0024 S 0:GET_MAP_STRING_INT64                                 1   0   0
0025 A 0:ADD_INT64                                            0   0   1
0026 A 2:RETURN                                               0  10   1    ; 1 values
