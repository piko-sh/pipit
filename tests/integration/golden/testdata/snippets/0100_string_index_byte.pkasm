; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4 string=1 uint64=2
;   dispatch:  asm=7 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=4
;   strings: [0]="Hello"

0000 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "Hello"
0001 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0002 A 0:GET_STRING_BYTE_AS_INT64                             1   0   0
0003 A 1:LOAD_INT64_IMMEDIATE                                75   2   4    ; ints[2] = 4
0004 A 0:GET_STRING_BYTE_AS_INT64                             3   0   2
0005 A 0:ADD_INT64                                            0   1   3
0006 A 2:RETURN                                               0  10   1    ; 1 values
