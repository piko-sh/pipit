; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=4 string=1 uint=2
;   dispatch:  asm=7 shim=0 exit=0 go=2
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=4
;   strings: [0]="Hello"

0000 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "Hello"
0001 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0002 A 0:STRING_INDEX_TO_INT        1   0   0
0003 G 3:TIER3_NOP                  0   0   0
0004 A 1:LOAD_INT_CONST_SMALL      75   2   4    ; ints[2] = 4
0005 A 0:STRING_INDEX_TO_INT        3   0   2
0006 G 3:TIER3_NOP                  0   0   0
0007 A 0:ADD_INT                    0   1   3
0008 A 2:TIER2_RETURN               0  10   1    ; 1 values
