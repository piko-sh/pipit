; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function makeSlice
;   registers: int=1 general=2 uint=1 sliceByte=1
;   dispatch:  asm=6 shim=3 exit=0 go=3
;   params:    (none)
;   returns:   (sliceByte)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=2  [1]=0  [2]=1
;   uints:   [0]=104  [1]=105

0000 A 1:LOAD_INT_CONST_SMALL      75   0   2    ; ints[0] = 2
0001 S 0:MAKE_SLICE                 0   0   0
0002   0:EXT                        0   0   0
0003 A 1:LOAD_UINT_CONST_SMALL     99   0 104    ; uints[0] = 104
0004 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0005 G 0:PACK_TYPED                 1   0   5
0006   0:EXT                        1   0   0
0007 S 0:INDEX_SET                  0   0   1
0008 A 1:LOAD_UINT_CONST_SMALL     99   0 105    ; uints[0] = 105
0009 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0010 G 0:PACK_TYPED                 1   0   5
0011   0:EXT                        1   0   0
0012 S 0:INDEX_SET                  0   0   1
0013 G 1:ADOPT_GENERAL_TO_SLICES_BYTE 160   0   0
0014 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=2 general=2 uint=1 sliceByte=1
;   dispatch:  asm=6 shim=2 exit=1 go=3
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=16
;   uints:   [0]=97  [1]=122

0000 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT_CONST_SMALL      75   1  16    ; ints[1] = 16
0002 S 0:MAKE_SLICE                 0   0   1
0003   0:EXT                        0   0   0
0004 A 1:LOAD_UINT_CONST_SMALL     99   0  97    ; uints[0] = 97
0005 X 0:APPEND_BYTE_FAST           0   0   0
0006 A 1:CALL                     128   0   0    ; call (site 0)
0007 S 0:PACK_INTERFACE             1   0  12
0008 G 1:APPEND_BYTE_SPREAD_INPLACE 189   0   1
0009 A 1:LOAD_UINT_CONST_SMALL     99   0 122    ; uints[0] = 122
0010 G 0:APPEND_BYTE_FAST_INPLACE   0   0   0
0011 G 1:LEN                       70   0   0
0012 A 2:TIER2_RETURN               0  10   1    ; 1 values
