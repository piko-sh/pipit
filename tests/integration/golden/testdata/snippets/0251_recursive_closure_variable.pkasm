; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=2 general=3
;   dispatch:  asm=4 shim=5 exit=1 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=5

0000 S 0:LOAD_GENERAL_CONST         0   0   0
0001 S 0:ALLOC_INDIRECT             1   0   3
0002   0:EXT                        0   0   0
0003 S 0:MAKE_CLOSURE               2   1   0    ; closure (func 1)
0004 X 0:SET_FIELD                  1 255   2
0005 S 0:DEREF                      2   1   0
0006 A 1:LOAD_INT_CONST_SMALL      75   0   5    ; ints[0] = 5
0007 A 1:CALL                     128   0   0    ; call closure general[2] (site 0)
0008 S 2:SYNC_CLOSURE_UPVALUES      0  15   2
0009 A 1:MOVE_INT                  35   0   1
0010 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: int=4 general=1
;   dispatch:  asm=9 shim=0 exit=0 go=0
;   params:    (int)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1

0000 A 1:LE_INT_CONST_JUMP_FALSE  122   0   0
0001   0:EXT                        3   0   0
0002 A 1:LOAD_INT_CONST_SMALL      75   1   1    ; ints[1] = 1
0003 A 1:MOVE_INT                  35   0   1
0004 A 2:TIER2_RETURN               0  10   1    ; 1 values
0005 A 0:GET_UPVALUE                0   0   3
0006 A 0:SUB_INT_CONST              2   0   0    ; const = 1
0007 A 1:CALL                     128   0   0    ; call closure general[0] (site 0)
0008 A 0:MUL_INT                    0   0   3
0009 A 2:TIER2_RETURN               0  10   1    ; 1 values
