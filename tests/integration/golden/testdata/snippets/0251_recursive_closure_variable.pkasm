; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2 general=3
;   dispatch:  asm=4 shim=5 exit=1 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=5

0000 S 0:LOAD_GENERAL_CONSTANT                                0   0   0
0001 S 0:ALLOCATE_INDIRECT                                    1   0   3
0002   0:EXTENSION                                            0   0   0
0003 S 0:MAKE_CLOSURE                                         2   1   0    ; closure (func 1)
0004 X 0:SET_FIELD                                            1 255   2
0005 S 0:DEREFERENCE                                          2   1   0
0006 A 1:LOAD_INT64_IMMEDIATE                                75   0   5    ; ints[0] = 5
0007 A 1:CALL                                               128   0   0    ; call closure general[2] (site 0)
0008 S 2:SYNCHRONISE_CLOSURE_CAPTURED_VARIABLES               0  15   2
0009 A 1:MOVE_INT64                                          35   0   1
0010 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: int64=4 general=1
;   dispatch:  asm=8 shim=0 exit=0 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1

0000 A 1:LESS_OR_EQUAL_INT64_CONSTANT_THEN_JUMP_IF_FALSE    122   0   0
0001   0:EXTENSION                                            2   0   0
0002 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0003 A 2:RETURN                                               0  10   1    ; 1 values
0004 A 0:GET_CAPTURED_VARIABLE                                0   0   3
0005 A 0:SUBTRACT_INT64_CONSTANT                              2   0   0    ; const = 1
0006 A 1:CALL                                               128   0   0    ; call closure general[0] (site 0)
0007 A 0:MULTIPLY_INT64                                       0   0   3
0008 A 2:RETURN                                               0  10   1    ; 1 values
