; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: complex=4
;   dispatch:  asm=3 shim=3 exit=0 go=0
;   params:    (none)
;   returns:   (complex)
; ═════════════════════════════════════════════════════════════

; constants:
;   complex: [0]=(1+2i)  [1]=(2+2i)

0000 S 0:LOAD_COMPLEX_CONST         1   0   0
0001 A 1:MOVE_COMPLEX              15   0   1
0002 S 0:LOAD_COMPLEX_CONST         3   1   0
0003 A 1:MOVE_COMPLEX              15   2   3
0004 S 0:ADD_COMPLEX                0   0   2
0005 A 2:TIER2_RETURN               0  10   1    ; 1 values
