; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function producer
;   registers: int64=4 general=1
;   dispatch:  asm=4 shim=0 exit=0 go=2
;   params:    (general, int64)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1

0000 A 1:LOAD_INT64_IMMEDIATE                                75   1   1    ; ints[1] = 1
0001 A 1:LESS_OR_EQUAL_INT64_THEN_JUMP_IF_FALSE             117   1   0
0002   0:EXTENSION                                            3   0   0
0003 G 0:SEND_TO_CHANNEL                                      0   1   0
0004 A 1:INCREMENT_INT64_THEN_JUMP_IF_LESS_OR_EQUAL         223   1   0
0005   0:EXTENSION                                          253 255   0
0006 G 2:CLOSE_CHANNEL                                        0   8   0
0007 A 3:RETURN_VOID                                          0   0   1

; ═════════════════════════════════════════════════════════════
; function consumer
;   registers: int64=4 general=2
;   dispatch:  asm=5 shim=2 exit=0 go=0
;   params:    (general)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0001 S 1:RANGE_INITIALISE                                   142   1   0
0002 S 1:RANGE_NEXT                                         143   1   1
0003   0:EXTENSION                                            1   2   0
0004   0:EXTENSION                                            0   0   0
0005 A 0:JUMP_IF_FALSE                                        1   2   0    ; if ints[1] == 0 goto +2
0006 A 0:ADD_INT64                                            0   0   2
0007 A 1:JUMP                                                74 250 255    ; goto -6
0008 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=1 general=2
;   dispatch:  asm=4 shim=1 exit=0 go=2
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=5

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   5    ; ints[0] = 5
0001 G 1:MAKE_CHANNEL                                        80   0   0
0002   0:EXTENSION                                            0   0   0
0003 S 0:MAKE_CLOSURE                                         1   0   0    ; closure (func 0)
0004 A 1:LOAD_INT64_IMMEDIATE                                75   0   5    ; ints[0] = 5
0005 G 0:GO                                                   1   2   0
0006   0:EXTENSION                                            0   0   3
0007   0:EXTENSION                                            0   0   0
0008 A 1:CALL                                               128   0   0    ; call (site 0)
0009 A 2:RETURN                                               0  10   1    ; 1 values
