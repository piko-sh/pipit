; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2 string=1 general=3 sliceByte=1
;   dispatch:  asm=4 shim=7 exit=0 go=0
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=8

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT64_IMMEDIATE                                75   1   8    ; ints[1] = 8
0002 S 1:MAKE_SLICE_HEAP                                    208   0   0
0003   0:EXTENSION                                            1  12   0
0004 S 0:ALLOCATE_INDIRECT                                    0   0  12
0005   0:EXTENSION                                            0   0   0
0006 S 0:MAKE_CLOSURE                                         1   1   0    ; closure (func 1)
0007 A 1:CALL                                               128   0   0    ; call closure general[1] (site 0)
0008 S 2:SYNCHRONISE_CLOSURE_CAPTURED_VARIABLES               0  15   1
0009 S 0:DEREFERENCE                                          2   0   0
0010 S 0:UNBOX_FROM_INTERFACE                                 0   2  12
0011 S 1:CONVERT_SLICE_BYTE_TO_STRING                       149   0   0
0012 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: general=2 uint64=1 sliceByte=2
;   dispatch:  asm=10 shim=3 exit=1 go=0
;   params:    (none)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; constants:
;   uints:   [0]=120  [1]=121  [2]=122

0000 A 0:GET_CAPTURED_VARIABLE                                0   0  12
0001 S 1:BOX_SLICE_BYTE                                     148   0   0
0002 A 0:GET_CAPTURED_VARIABLE                                0   0  12
0003 A 1:LOAD_UINT64_IMMEDIATE                               99   0 120    ; uints[0] = 120
0004 A 1:APPEND_SLICE_BYTE                                  176   1   0
0005   0:EXTENSION                                            0   0   0
0006 S 0:SET_CAPTURED_VARIABLE                                1   0  12
0007 A 0:GET_CAPTURED_VARIABLE                                0   0  12
0008 A 1:LOAD_UINT64_IMMEDIATE                               99   0 121    ; uints[0] = 121
0009 A 1:APPEND_SLICE_BYTE                                  176   1   0
0010   0:EXTENSION                                            0   0   0
0011 S 0:SET_CAPTURED_VARIABLE                                1   0  12
0012 A 1:LOAD_UINT64_IMMEDIATE                               99   0 122    ; uints[0] = 122
0013 X 0:APPEND_BYTE                                          1   0   0
0014 A 0:MOVE_GENERAL                                         0   1   1
0015 A 3:RETURN_VOID                                          0   0   1
