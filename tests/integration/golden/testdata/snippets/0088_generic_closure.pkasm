; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function makeMultiplier
;   registers: general=2
;   dispatch:  asm=2 shim=1 exit=0 go=0
;   params:    (general)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 S 0:MAKE_CLOSURE                                         1   2   0    ; closure (func 2)
0001 A 0:MOVE_GENERAL                                         0   1   0
0002 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=2 general=1
;   dispatch:  asm=6 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=7

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   3    ; ints[0] = 3
0001 A 1:CALL                                               128   0   0    ; call (site 0)
0002 A 1:LOAD_INT64_IMMEDIATE                                75   0   7    ; ints[0] = 7
0003 A 1:CALL                                               128   1   0    ; call closure general[0] (site 1)
0004 A 1:MOVE_INT64                                          35   0   1
0005 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: general=3
;   dispatch:  asm=3 shim=0 exit=0 go=1
;   params:    (general)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 A 0:GET_CAPTURED_VARIABLE                                1   0   3
0001 G 0:MULTIPLY_GENERAL                                     2   0   1
0002 A 0:MOVE_GENERAL                                         0   2   0
0003 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function makeMultiplier[spec:int]
;   registers: int64=1 general=1
;   dispatch:  asm=1 shim=1 exit=0 go=0
;   params:    (int64)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 S 0:MAKE_CLOSURE                                         0   4   0    ; closure (func 4)
0001 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: int64=2
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

0000 A 0:GET_CAPTURED_VARIABLE                                1   0   0
0001 A 0:MULTIPLY_INT64                                       0   0   1
0002 A 2:RETURN                                               0  10   1    ; 1 values
