; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function makeMultiplier
;   registers: general=2
;   dispatch:  asm=2 shim=1 exit=0 go=0
;   params:    (general)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 S 0:MAKE_CLOSURE               1   2   0    ; closure (func 2)
0001 A 0:MOVE_GENERAL               0   1   0
0002 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=2 general=1
;   dispatch:  asm=6 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=7

0000 A 1:LOAD_INT_CONST_SMALL      75   0   3    ; ints[0] = 3
0001 A 1:CALL                     128   0   0    ; call (site 0)
0002 A 1:LOAD_INT_CONST_SMALL      75   0   7    ; ints[0] = 7
0003 A 1:CALL                     128   1   0    ; call closure general[0] (site 1)
0004 A 1:MOVE_INT                  35   0   1
0005 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: general=3
;   dispatch:  asm=3 shim=0 exit=0 go=1
;   params:    (general)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 A 0:GET_UPVALUE                1   0   3
0001 G 0:MUL                        2   0   1
0002 A 0:MOVE_GENERAL               0   2   0
0003 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function makeMultiplier[spec:int]
;   registers: int=1 general=1
;   dispatch:  asm=1 shim=1 exit=0 go=0
;   params:    (int)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 S 0:MAKE_CLOSURE               0   4   0    ; closure (func 4)
0001 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function <closure>
;   registers: int=2
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (int)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

0000 A 0:GET_UPVALUE                1   0   0
0001 A 0:MUL_INT                    0   0   1
0002 A 2:TIER2_RETURN               0  10   1    ; 1 values
