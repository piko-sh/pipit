; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=3 float=4
;   dispatch:  asm=18 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=0
;   floats:  [0]=0  [1]=1

0000 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 0
0001 A 1:MATH_SIN                   1   1   0
0002 A 1:MOVE_FLOAT                36   0   1
0003 A 0:LOAD_FLOAT_CONST           1   0   0    ; floats[1] = 0
0004 A 1:MATH_COS                   2   2   1
0005 A 1:MOVE_FLOAT                36   1   2
0006 A 0:LOAD_FLOAT_CONST           2   0   0    ; floats[2] = 0
0007 A 0:EQ_FLOAT                   0   0   2
0008 A 1:MOVE_INT                  35   1   0
0009 A 0:JUMP_IF_FALSE              1   3   0    ; if ints[1] == 0 goto +3
0010 A 0:LOAD_FLOAT_CONST           3   1   0    ; floats[3] = 1
0011 A 0:EQ_FLOAT                   2   1   3
0012 A 1:MOVE_INT                  35   1   2
0013 A 0:JUMP_IF_FALSE              1   2   0    ; if ints[1] == 0 goto +2
0014 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0015 A 2:TIER2_RETURN               0  10   1    ; 1 values
0016 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0017 A 2:TIER2_RETURN               0  10   1    ; 1 values
