; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=3 float64=4
;   dispatch:  asm=15 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=0
;   floats:  [0]=0  [1]=1

0000 A 0:LOAD_FLOAT64_CONSTANT                                0   0   0    ; floats[0] = 0
0001 A 1:MATH_SIN                                             1   0   0
0002 A 0:LOAD_FLOAT64_CONSTANT                                1   0   0    ; floats[1] = 0
0003 A 1:MATH_COS                                             2   1   1
0004 A 0:LOAD_FLOAT64_CONSTANT                                2   0   0    ; floats[2] = 0
0005 A 0:EQUAL_FLOAT64                                        0   0   2
0006 A 1:MOVE_INT64                                          35   1   0
0007 A 0:JUMP_IF_FALSE                                        1   5   0    ; if ints[1] == 0 goto +5
0008 A 0:LOAD_FLOAT64_CONSTANT                                3   1   0    ; floats[3] = 1
0009 A 0:EQUAL_FLOAT64                                        1   1   3
0010 A 0:JUMP_IF_FALSE                                        1   2   0    ; if ints[1] == 0 goto +2
0011 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0012 A 2:RETURN                                               0  10   1    ; 1 values
0013 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0014 A 2:RETURN                                               0  10   1    ; 1 values
