; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: uint=4
;   dispatch:  asm=5 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (uint)
; ═════════════════════════════════════════════════════════════

; constants:
;   uints:   [0]=10  [1]=3

0000 A 1:LOAD_UINT_CONST_SMALL     99   1  10    ; uints[1] = 10
0001 A 1:MOVE_UINT                 39   0   1
0002 A 1:SUB_UINT_CONST            97   3   0
0003   0:EXT                        1   0   0
0004 A 1:MOVE_UINT                 39   0   3
0005 A 2:TIER2_RETURN               0  10   1    ; 1 values
