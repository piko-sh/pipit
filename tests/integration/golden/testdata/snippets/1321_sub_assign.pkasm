; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: uint64=3
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (uint64)
; ═════════════════════════════════════════════════════════════

; constants:
;   uints:   [0]=10  [1]=3

0000 A 1:LOAD_UINT64_IMMEDIATE                               99   0  10    ; uints[0] = 10
0001 A 1:SUBTRACT_UINT64_CONSTANT                            97   0   0
0002   0:EXTENSION                                            1   0   0
0003 A 2:RETURN                                               0  10   1    ; 1 values
