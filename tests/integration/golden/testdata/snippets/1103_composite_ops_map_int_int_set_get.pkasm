; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=4 general=3
;   dispatch:  asm=8 shim=4 exit=0 go=3
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=10  [2]=20  [3]=2

0000 G 2:MAKE_MAP                   0  12   0
0001   0:EXT                        0   0   1
0002 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0003 A 1:LOAD_INT_CONST_SMALL      75   1  10    ; ints[1] = 10
0004 G 1:MOVE_INT_TO_GENERAL       40   1   0
0005 G 1:MOVE_INT_TO_GENERAL       40   2   1
0006 S 0:MAP_SET                    0   1   2
0007 A 1:LOAD_INT_CONST_SMALL      75   0  20    ; ints[0] = 20
0008 A 1:LOAD_INT_CONST_SMALL      75   1   2    ; ints[1] = 2
0009 S 0:MAP_SET_INT_INT            0   1   0
0010 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0011 S 0:MAP_GET_INT_INT            1   0   0
0012 A 1:LOAD_INT_CONST_SMALL      75   2   2    ; ints[2] = 2
0013 S 0:MAP_GET_INT_INT            3   0   2
0014 A 0:ADD_INT                    0   1   3
0015 A 2:TIER2_RETURN               0  10   1    ; 1 values
