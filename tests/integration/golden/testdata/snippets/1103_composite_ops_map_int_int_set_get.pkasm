; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4 general=3
;   dispatch:  asm=8 shim=7 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=10  [2]=20  [3]=2

0000 S 2:MAKE_MAP                                             0  12   0
0001   0:EXTENSION                                            0   0   1
0002 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0003 A 1:LOAD_INT64_IMMEDIATE                                75   1  10    ; ints[1] = 10
0004 S 1:BOX_INT64                                           40   1   0
0005 S 1:BOX_INT64                                           40   2   1
0006 S 0:SET_MAP                                              0   1   2
0007 A 1:LOAD_INT64_IMMEDIATE                                75   0  20    ; ints[0] = 20
0008 A 1:LOAD_INT64_IMMEDIATE                                75   1   2    ; ints[1] = 2
0009 S 0:SET_MAP_INT64_INT64                                  0   1   0
0010 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0011 S 0:GET_MAP_INT64_INT64                                  1   0   0
0012 A 1:LOAD_INT64_IMMEDIATE                                75   2   2    ; ints[2] = 2
0013 S 0:GET_MAP_INT64_INT64                                  3   0   2
0014 A 0:ADD_INT64                                            0   1   3
0015 A 2:RETURN                                               0  10   1    ; 1 values
