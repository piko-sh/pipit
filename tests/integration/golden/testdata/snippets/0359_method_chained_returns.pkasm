; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function Builder.Add
;   registers: string=1 general=2 sliceString=2
;   dispatch:  asm=3 shim=0 exit=0 go=2
;   params:    (general, string)
;   returns:   (general)
; ═════════════════════════════════════════════════════════════

0000 A 0:MOVE_GENERAL               1   0   0
0001 G 1:GET_STRUCT_FIELD_SLICE_STRING 193   0   0
0002   0:EXT                        0   0   0
0003 A 1:APPEND_SLICE_STRING_DIRECT 173   1   0
0004   0:EXT                        0   0   0
0005 G 1:SET_STRUCT_FIELD_SLICE_STRING 199   1   1
0006   0:EXT                        0   0   0
0007 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function Builder.Result
;   registers: int=4 string=3 general=1 sliceString=1
;   dispatch:  asm=9 shim=1 exit=0 go=1
;   params:    (general)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=1
;   strings: [0]=""

0000 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = ""
0001 G 1:GET_STRUCT_FIELD_SLICE_STRING 193   0   0
0002   0:EXT                        0   0   0
0003 A 1:LEN_SLICE_STRING_DIRECT   25   0   0
0004 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0005 A 1:LT_INT_JUMP_FALSE        116   1   0
0006   0:EXT                        6   0   0
0007 A 1:SLICE_GET_STRING_DIRECT   23   1   0
0008   0:EXT                        1   0   0
0009 S 0:CONCAT_STRING              2   0   1
0010 A 1:MOVE_STRING               37   0   2
0011 A 0:ADD_INT_CONST              1   1   1    ; const = 1
0012 A 1:JUMP                      74 248 255    ; goto -8
0013 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function run
;   registers: string=4 general=5
;   dispatch:  asm=9 shim=1 exit=0 go=1
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   strings: [0]="a"  [1]="b"  [2]="c"

0000 G 2:MAKE_MAP                   0  12   0
0001   0:EXT                        0   0   0
0002 S 0:ADDR                       1   0   0
0003 A 0:LOAD_STRING_CONST          0   0   0    ; strings[0] = "a"
0004 A 1:CALL                     128   0   0    ; call (site 0)
0005 A 0:LOAD_STRING_CONST          1   1   0    ; strings[1] = "b"
0006 A 1:CALL                     128   1   0    ; call (site 1)
0007 A 0:LOAD_STRING_CONST          2   2   0    ; strings[2] = "c"
0008 A 1:CALL                     128   2   0    ; call (site 2)
0009 A 1:CALL                     128   3   0    ; call (site 3)
0010 A 1:MOVE_STRING               37   0   3
0011 A 2:TIER2_RETURN               0  10   1    ; 1 values
