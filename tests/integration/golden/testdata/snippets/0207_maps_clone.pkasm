; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: string=2 general=3
;   dispatch:  asm=7 shim=7 exit=0 go=1
;   params:    (none)
;   returns:   (string)
; ═════════════════════════════════════════════════════════════

; constants:
;   strings: [0]="key"  [1]="original"  [2]="modified"

0000 S 2:MAKE_MAP                                             0  12   0
0001   0:EXTENSION                                            0   0   1
0002 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "key"
0003 A 0:LOAD_STRING_CONSTANT                                 1   1   0    ; strings[1] = "original"
0004 S 1:BOX_STRING                                          44   1   0
0005 S 1:BOX_STRING                                          44   2   1
0006 S 0:SET_MAP                                              0   1   2
0007 S 0:LOAD_GENERAL_CONSTANT                                1   0   0
0008 G 1:CALL_NATIVE                                        130   0   0    ; call native general[1] (site 0)
0009 A 0:MOVE_GENERAL                                         1   2   1
0010 A 0:LOAD_STRING_CONSTANT                                 0   2   0    ; strings[0] = "modified"
0011 A 0:LOAD_STRING_CONSTANT                                 1   0   0    ; strings[1] = "key"
0012 S 0:SET_MAP_STRING_STRING                                1   1   0
0013 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; strings[0] = "key"
0014 S 0:GET_MAP_STRING_STRING                                0   0   0
0015 A 2:RETURN                                               0  10   1    ; 1 values
