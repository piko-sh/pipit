; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=7
;   dispatch:  asm=6 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=32  [2]=3

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT64_IMMEDIATE                                75   1   0    ; ints[1] = 0
0002 A 1:LESS_THAN_INT64_CONSTANT_THEN_JUMP_IF_FALSE        123   1   1
0003   0:EXTENSION                                            4   0   0
0004 A 0:MULTIPLY_INT64_CONSTANT_THEN_ADD                     0   1   2    ; const = 3
0005   0:EXTENSION                                            0   0   0
0006 A 1:INCREMENT_INT64_THEN_JUMP_IF_LESS_THAN_CONSTANT    215   1   1
0007   0:EXTENSION                                          252 255   0
0008 A 2:RETURN                                               0  10   1    ; 1 values
