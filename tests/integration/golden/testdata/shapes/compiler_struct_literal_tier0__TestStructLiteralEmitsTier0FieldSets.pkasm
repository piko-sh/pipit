; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int=3 string=1 general=2
;   dispatch:  asm=9 shim=1 exit=0 go=4
;   params:    (int)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0
;   strings: [0]="v"

0000 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0001 S 0:MAKE_SLICE                 0   1   1
0002   0:EXT                        0   0   0
0003 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0004 A 0:LOAD_STRING_CONST          0   0   0    ; LICM hoist of PC 9
0005 A 1:LT_INT_JUMP_FALSE        116   1   0
0006   0:EXT                        8   0   0
0007 G 2:MAKE_MAP                   0  12   1
0008   0:EXT                        1   0   0
0009 A 0:SET_STRUCT_FIELD_INT_T0    1   1   0
0010 G 1:SET_STRUCT_FIELD_STRING   95   1   0
0011   0:EXT                        1   0   0
0012 G 0:APPEND_INPLACE             0   0   1
0013 A 2:TIER2_INC_INT              0   1   1
0014 A 1:JUMP                      74 246 255    ; goto -10
0015 G 1:LEN                       70   1   0
0016 A 1:MOVE_INT                  35   0   1
0017 A 2:TIER2_RETURN               0  10   1    ; 1 values
