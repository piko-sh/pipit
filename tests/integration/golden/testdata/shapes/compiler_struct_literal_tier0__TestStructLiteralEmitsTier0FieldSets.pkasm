; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=4 string=1 general=2
;   dispatch:  asm=8 shim=3 exit=1 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0
;   strings: [0]="v"

0000 A 1:LOAD_INT64_IMMEDIATE                                75   1   0    ; ints[1] = 0
0001 S 0:MAKE_SLICE                                           0   1   1
0002   0:EXTENSION                                            0   0   0
0003 A 1:LOAD_INT64_IMMEDIATE                                75   1   0    ; ints[1] = 0
0004 A 1:LESS_THAN_INT64_THEN_JUMP_IF_FALSE                 116   1   0
0005   0:EXTENSION                                            9   0   0
0006 A 0:LOAD_STRING_CONSTANT                                 0   0   0    ; LICM hoist of PC 9
0007 S 2:MAKE_MAP                                             0  12   1
0008   0:EXTENSION                                            1   0   0
0009 A 0:SET_STRUCT_FIELD_INT64                               1   1   0
0010 S 1:SET_STRUCT_FIELD_STRING_WIDE                        95   1   0
0011   0:EXTENSION                                            1   0   0
0012 X 0:APPEND                                               0   0   1
0013 A 1:INCREMENT_INT64_THEN_JUMP_IF_LESS_THAN              77   1   0
0014   0:EXTENSION                                          248 255   0
0015 A 1:LENGTH_GENERAL                                      70   0   0
0016 A 2:RETURN                                               0  10   1    ; 1 values
