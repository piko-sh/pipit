;   returns:   (general)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0
;   floats:  [0]=0.5

0000 S 0:MAKE_SLICE                                           0   0   0
0001   0:EXTENSION                                            0   0   1
0002 A 1:LOAD_INT64_IMMEDIATE                                75   1   0    ; ints[1] = 0
0003 A 1:LESS_THAN_INT64_THEN_JUMP_IF_FALSE                 116   1   0
0004   0:EXTENSION                                           17   0   0
0005 A 0:LOAD_FLOAT64_CONSTANT                                1   0   0    ; LICM hoist of PC 10
0006 S 1:MAKE_SLICE_HEAP                                    208   0   0
0007   0:EXTENSION                                            0   8   0
0008 A 1:LOAD_INT64_IMMEDIATE                                75   3   0    ; ints[3] = 0
0009 A 1:LESS_THAN_INT64_THEN_JUMP_IF_FALSE                 116   3   0
0010   0:EXTENSION                                            7   0   0
0011 A 0:MULTIPLY_INT64                                       5   1   3
0012 A 1:CONVERT_INT64_TO_FLOAT64                            50   0   5
0013 A 0:MULTIPLY_FLOAT64                                     2   0   1
0014 A 1:SET_SLICE_FLOAT64_ELEMENT                           20   0   3
0015   0:EXTENSION                                            2   0   0
0016 A 1:INCREMENT_INT64_THEN_JUMP_IF_LESS_THAN              77   3   0
0017   0:EXTENSION                                          249 255   0
0018 S 0:BOX_AS_INTERFACE                                     1   0   8
0019 S 0:SET_ELEMENT                                          0   1   1
0020 A 1:INCREMENT_INT64_THEN_JUMP_IF_LESS_THAN              77   1   0
0021   0:EXTENSION                                          240 255   0
0022 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=2 general=1
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=4

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   4    ; ints[0] = 4
0001 A 1:CALL                                               128   0   0    ; call (site 0)
0002 A 1:LENGTH_GENERAL                                      70   0   0
0003 A 2:RETURN                                               0  10   1    ; 1 values
