; constants:
;   ints:    [0]=0
;   floats:  [0]=0.5

0000 S 0:MAKE_SLICE                 0   0   0
0001   0:EXT                        0   0   1
0002 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0003 A 0:LOAD_FLOAT_CONST           1   0   0    ; LICM hoist of PC 8
0004 A 1:LT_INT_JUMP_FALSE        116   1   0
0005   0:EXT                       16   0   0
0006 G 1:MAKE_SLICE_HEAP          208   0   0
0007   0:EXT                        0   8   0
0008 A 1:LOAD_INT_CONST_SMALL      75   3   0    ; ints[3] = 0
0009 A 1:LT_INT_JUMP_FALSE        116   3   0
0010   0:EXT                        7   0   0
0011 A 0:MUL_INT                    5   1   3
0012 A 1:INT_TO_FLOAT              50   0   5
0013 A 0:MUL_FLOAT                  2   0   1
0014 A 1:SLICE_SET_FLOAT_DIRECT    20   0   3
0015   0:EXT                        2   0   0
0016 A 2:TIER2_INC_INT              0   1   3
0017 A 1:JUMP                      74 247 255    ; goto -9
0018 S 0:PACK_INTERFACE             1   0   8
0019 S 0:INDEX_SET                  0   1   1
0020 A 2:TIER2_INC_INT              0   1   1
0021 A 1:JUMP                      74 238 255    ; goto -18
0022 A 2:TIER2_RETURN               0  10   1    ; 1 values

