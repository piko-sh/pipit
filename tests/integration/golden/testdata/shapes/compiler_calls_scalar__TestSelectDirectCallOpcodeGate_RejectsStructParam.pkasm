; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function add
;   registers: int=2 general=1
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (general)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

0000 A 0:GET_STRUCT_FIELD_INT_T0    0   0   0
0001 A 0:GET_STRUCT_FIELD_INT_T0    1   0   1
0002 A 0:ADD_INT                    0   0   1
0003 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int=1 general=1
;   dispatch:  asm=6 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=4

0000 A 2:ALLOC_STRUCT_LITERAL       0  14   0
0001   0:EXT                        0   0   0
0002 A 1:LOAD_INT_CONST_SMALL      75   0   3    ; ints[0] = 3
0003 A 0:SET_STRUCT_FIELD_INT_T0    0   0   0
0004 A 1:LOAD_INT_CONST_SMALL      75   0   4    ; ints[0] = 4
0005 A 0:SET_STRUCT_FIELD_INT_T0    0   0   1
0006 A 1:TAIL_CALL                129   0   0    ; tail call (site 0)
