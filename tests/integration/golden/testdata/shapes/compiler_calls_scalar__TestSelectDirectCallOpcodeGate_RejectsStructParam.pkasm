; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function add
;   registers: int64=2 general=1
;   dispatch:  asm=4 shim=0 exit=0 go=0
;   params:    (general)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

0000 A 0:GET_STRUCT_FIELD_INT64                               0   0   0
0001 A 0:GET_STRUCT_FIELD_INT64                               1   0   1
0002 A 0:ADD_INT64                                            0   0   1
0003 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=3 general=1
;   dispatch:  asm=9 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=3  [1]=4

0000 A 2:ALLOCATE_STRUCT_LITERAL                              0  14   0
0001   0:EXTENSION                                            0   0   0
0002 A 1:LOAD_INT64_IMMEDIATE                                75   0   3    ; ints[0] = 3
0003 A 0:SET_STRUCT_FIELD_INT64                               0   0   0
0004 A 1:LOAD_INT64_IMMEDIATE                                75   0   4    ; ints[0] = 4
0005 A 0:SET_STRUCT_FIELD_INT64                               0   0   1
0006 A 0:GET_STRUCT_FIELD_INT64                               0   0   0    ; inlined body of function 0 called at PC 6
0007 A 0:GET_STRUCT_FIELD_INT64                               2   0   1
0008 A 0:ADD_INT64                                            0   0   2
0009 A 2:RETURN                                               0  10   1    ; 1 values
