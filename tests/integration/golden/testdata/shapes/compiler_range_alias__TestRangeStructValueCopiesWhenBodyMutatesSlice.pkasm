; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function sum
;   registers: int=4 float=5 general=3
;   dispatch:  asm=12 shim=2 exit=0 go=1
;   params:    (general)
;   returns:   (float)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=1
;   floats:  [0]=0  [1]=100

0000 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 0
0001 G 1:LEN                       70   0   0
0002 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0003 A 0:LOAD_FLOAT_CONST           4   1   0    ; LICM hoist of PC 8
0004 A 1:LOAD_INT_CONST_SMALL      75   3   1    ; LICM hoist of PC 8
0005 A 1:LT_INT_JUMP_FALSE        116   1   0
0006   0:EXT                        8   0   0
0007 S 0:INDEX                      1   0   1
0008 A 0:GET_STRUCT_FIELD_FLOAT_T0   1   1   0    ; aggregate snapshot replaced by field captures
0009 S 0:INDEX                      2   0   3
0010 A 0:SET_STRUCT_FIELD_FLOAT_T0   2   4   0
0011 A 0:ADD_FLOAT                  2   0   1
0012 A 1:MOVE_FLOAT                36   0   2
0013 A 0:ADD_INT_CONST              1   1   1    ; const = 1
0014 A 1:JUMP                      74 246 255    ; goto -10
0015 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int=1 float=1 general=2
;   dispatch:  asm=14 shim=3 exit=0 go=0
;   params:    (none)
;   returns:   (float)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=2  [1]=0  [2]=1
;   floats:  [0]=1  [1]=2  [2]=3  [3]=4

0000 A 1:LOAD_INT_CONST_SMALL      75   0   2    ; ints[0] = 2
0001 S 0:MAKE_SLICE                 0   0   0
0002   0:EXT                        0   0   0
0003 A 2:ALLOC_STRUCT_LITERAL       0  14   1
0004   0:EXT                        1   0   0
0005 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 1
0006 A 0:SET_STRUCT_FIELD_FLOAT_T0   1   0   0
0007 A 0:LOAD_FLOAT_CONST           0   1   0    ; floats[0] = 2
0008 A 0:SET_STRUCT_FIELD_FLOAT_T0   1   0   1
0009 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0010 S 0:INDEX_SET                  0   0   1
0011 A 2:ALLOC_STRUCT_LITERAL       0  14   1
0012   0:EXT                        1   0   0
0013 A 0:LOAD_FLOAT_CONST           0   2   0    ; floats[0] = 3
0014 A 0:SET_STRUCT_FIELD_FLOAT_T0   1   0   0
0015 A 0:LOAD_FLOAT_CONST           0   3   0    ; floats[0] = 4
0016 A 0:SET_STRUCT_FIELD_FLOAT_T0   1   0   1
0017 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0018 S 0:INDEX_SET                  0   0   1
0019 A 1:TAIL_CALL                129   0   0    ; tail call (site 0)
