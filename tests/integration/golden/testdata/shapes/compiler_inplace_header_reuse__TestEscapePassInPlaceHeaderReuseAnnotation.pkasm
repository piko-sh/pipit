;   dispatch:  asm=2 shim=1 exit=0 go=0
;   params:    (none)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

0000 S 0:LOAD_GENERAL_CONSTANT                                0   0   0
0001 A 0:SET_GLOBAL                                           0   0   3
0002 A 3:RETURN_VOID                                          0   0   1

