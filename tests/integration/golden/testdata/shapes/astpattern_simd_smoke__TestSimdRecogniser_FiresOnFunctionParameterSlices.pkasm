; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function dotRow
;   registers: int64=1 float64=1 sliceFloat64=2
;   dispatch:  asm=3 shim=0 exit=0 go=1
;   params:    (sliceFloat64, sliceFloat64)
;   returns:   (float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   floats:  [0]=0

0000 A 0:LOAD_FLOAT64_CONSTANT                                0   0   0    ; floats[0] = 0
0001 A 1:LENGTH_SLICE_FLOAT64                                21   0   0
0002 G 1:SIMD_DOT_PRODUCT_FLOAT64                           151   0   0
0003   0:EXTENSION                                            1   0   0
0004 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=1 float64=1 sliceFloat64=2
;   dispatch:  asm=4 shim=2 exit=0 go=0
;   params:    (none)
;   returns:   (float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=8

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   8    ; ints[0] = 8
0001 S 1:MAKE_SLICE_FLOAT64                                  18   0   0
0002   0:EXTENSION                                            0   0   0
0003 A 1:LOAD_INT64_IMMEDIATE                                75   0   8    ; ints[0] = 8
0004 S 1:MAKE_SLICE_FLOAT64                                  18   1   0
0005   0:EXTENSION                                            0   0   0
0006 A 1:CALL                                               128   0   0    ; call (site 0)
0007 A 2:RETURN                                               0  10   1    ; 1 values
