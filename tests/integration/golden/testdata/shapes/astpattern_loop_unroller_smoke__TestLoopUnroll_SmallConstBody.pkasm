; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function process
;   registers: int=1
;   params:    (int)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int=5
;   dispatch:  asm=21 shim=0 exit=0 go=1
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=2

0000 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0002 A 1:LOAD_INT_CONST_SMALL      75   2   2    ; ints[2] = 2
0003 A 0:MUL_INT                    3   1   2
0004 A 0:ADD_INT                    4   0   3
0005 A 1:MOVE_INT                  35   0   4
0006 A 1:LOAD_INT_CONST_SMALL      75   1   1    ; ints[1] = 1
0007 A 1:LOAD_INT_CONST_SMALL      75   2   2    ; ints[2] = 2
0008 A 0:MUL_INT                    3   1   2
0009 A 0:ADD_INT                    4   0   3
0010 A 1:MOVE_INT                  35   0   4
0011 A 1:LOAD_INT_CONST_SMALL      75   1   2    ; ints[1] = 2
0012 A 1:LOAD_INT_CONST_SMALL      75   2   2    ; ints[2] = 2
0013 A 0:MUL_INT                    3   1   2
0014 A 0:ADD_INT                    4   0   3
0015 A 1:MOVE_INT                  35   0   4
0016 A 1:LOAD_INT_CONST_SMALL      75   1   3    ; ints[1] = 3
0017 A 0:MUL_INT_CONST              3   1   1    ; const = 2
0018 G 3:TIER3_NOP                  0   0   0
0019 A 0:ADD_INT                    4   0   3
0020 A 1:MOVE_INT                  35   0   4
0021 A 2:TIER2_RETURN               0  10   1    ; 1 values
