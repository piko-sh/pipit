; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function process
;   registers: int=1
;   params:    (int)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int=5
;   dispatch:  asm=18 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=2

0000 A 1:LOAD_INT_CONST_SMALL      75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0002 A 0:MUL_INT_CONST              3   1   1    ; const = 2
0003 A 0:ADD_INT                    4   0   3
0004 A 1:MOVE_INT                  35   0   4
0005 A 1:LOAD_INT_CONST_SMALL      75   1   1    ; ints[1] = 1
0006 A 0:MUL_INT_CONST              3   1   1    ; const = 2
0007 A 0:ADD_INT                    4   0   3
0008 A 1:MOVE_INT                  35   0   4
0009 A 1:LOAD_INT_CONST_SMALL      75   1   2    ; ints[1] = 2
0010 A 0:MUL_INT_CONST              3   1   1    ; const = 2
0011 A 0:ADD_INT                    4   0   3
0012 A 1:MOVE_INT                  35   0   4
0013 A 1:LOAD_INT_CONST_SMALL      75   1   3    ; ints[1] = 3
0014 A 0:MUL_INT_CONST              3   1   1    ; const = 2
0015 A 0:ADD_INT                    4   0   3
0016 A 1:MOVE_INT                  35   0   4
0017 A 2:TIER2_RETURN               0  10   1    ; 1 values
