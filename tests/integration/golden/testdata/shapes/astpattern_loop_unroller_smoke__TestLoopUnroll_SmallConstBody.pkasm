; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function process
;   registers: int64=1
;   params:    (int64)
;   returns:   (none)
; ═════════════════════════════════════════════════════════════

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=5
;   dispatch:  asm=10 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0  [1]=2

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   0    ; ints[0] = 0
0001 A 1:LOAD_INT64_IMMEDIATE                                75   1   0    ; ints[1] = 0
0002 A 0:MULTIPLY_INT64_CONSTANT_THEN_ADD                     0   1   1    ; const = 2
0003   0:EXTENSION                                            0   0   0
0004 A 1:LOAD_INT64_IMMEDIATE                                75   1   1    ; ints[1] = 1
0005 A 0:MULTIPLY_INT64_CONSTANT_THEN_ADD                     0   1   1    ; const = 2
0006   0:EXTENSION                                            0   0   0
0007 A 1:LOAD_INT64_IMMEDIATE                                75   1   2    ; ints[1] = 2
0008 A 0:MULTIPLY_INT64_CONSTANT_THEN_ADD                     0   1   1    ; const = 2
0009   0:EXTENSION                                            0   0   0
0010 A 1:LOAD_INT64_IMMEDIATE                                75   1   3    ; ints[1] = 3
0011 A 0:MULTIPLY_INT64_CONSTANT_THEN_ADD                     0   1   1    ; const = 2
0012   0:EXTENSION                                            0   0   0
0013 A 2:RETURN                                               0  10   1    ; 1 values
