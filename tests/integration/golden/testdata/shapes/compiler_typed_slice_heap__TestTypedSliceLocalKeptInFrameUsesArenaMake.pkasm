; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function rowSum
;   registers: int64=4 float64=1 sliceFloat64=1
;   dispatch:  asm=8 shim=1 exit=0 go=1
;   params:    (int64)
;   returns:   (float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0
;   floats:  [0]=0

0000 S 1:MAKE_SLICE_FLOAT64                                  18   0   0
0001   0:EXTENSION                                            0   0   0
0002 A 1:LOAD_INT64_IMMEDIATE                                75   1   0    ; ints[1] = 0
0003 A 1:LESS_THAN_INT64_THEN_JUMP_IF_FALSE                 116   1   0
0004   0:EXTENSION                                            5   0   0
0005 A 1:CONVERT_INT64_TO_FLOAT64                            50   0   1
0006 A 1:SET_SLICE_FLOAT64_ELEMENT                           20   0   1
0007   0:EXTENSION                                            0   0   0
0008 A 1:INCREMENT_INT64_THEN_JUMP_IF_LESS_THAN              77   1   0
0009   0:EXTENSION                                          251 255   0
0010 A 0:LOAD_FLOAT64_CONSTANT                                0   0   0    ; floats[0] = 0
0011 A 1:LENGTH_SLICE_FLOAT64                                21   1   0
0012 G 1:SIMD_SUM_FLOAT64                                   152   0   0
0013   0:EXTENSION                                            1   0   0
0014 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=1 float64=1
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (float64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=8

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   8    ; ints[0] = 8
0001 A 1:CALL_SCALAR                                        134   0   0
0002 A 2:RETURN                                               0  10   1    ; 1 values
