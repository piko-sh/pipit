; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function rowSum
;   registers: int=3 float=1 sliceFloat=1
;   dispatch:  asm=9 shim=1 exit=0 go=1
;   params:    (int)
;   returns:   (float)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=0
;   floats:  [0]=0

0000 S 1:MAKE_SLICE_FLOAT          18   0   0
0001   0:EXT                        0   0   0
0002 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0003 A 1:LT_INT_JUMP_FALSE        116   1   0
0004   0:EXT                        5   0   0
0005 A 1:INT_TO_FLOAT              50   0   1
0006 A 1:SLICE_SET_FLOAT_DIRECT    20   0   1
0007   0:EXT                        0   0   0
0008 A 2:TIER2_INC_INT              0   1   1
0009 A 1:JUMP                      74 249 255    ; goto -7
0010 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 0
0011 A 1:LEN_SLICE_FLOAT_DIRECT    21   1   0
0012 G 1:SIMD_SUM_SLICE_FLOAT64   152   0   0
0013   0:EXT                        1   0   0
0014 A 2:TIER2_RETURN               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int=1
;   dispatch:  asm=2 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (float)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=8

0000 A 1:LOAD_INT_CONST_SMALL      75   0   8    ; ints[0] = 8
0001 A 1:TAIL_CALL                129   0   0    ; tail call (site 0)
