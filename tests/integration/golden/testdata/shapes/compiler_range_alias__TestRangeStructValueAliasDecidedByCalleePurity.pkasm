0000 A 0:LOAD_FLOAT64_CONSTANT                                1   0   0    ; floats[1] = 2
0001 A 0:MULTIPLY_FLOAT64                                     0   0   1
0002 A 2:RETURN                                               0  10   1    ; 1 values

