;   ints:    [0]=64  [1]=0  [2]=1
;   floats:  [0]=0

0000 A 1:LOAD_INT_CONST_SMALL      75   0  64    ; ints[0] = 64
0001 S 1:MAKE_SLICE_FLOAT          18   0   0
0002   0:EXT                        0   0   0
0003 A 1:LOAD_INT_CONST_SMALL      75   1   0    ; ints[1] = 0
0004 A 1:LEN_SLICE_FLOAT_DIRECT    21   2   0
0005 A 1:LT_INT_JUMP_FALSE        116   1   2
0006   0:EXT                        6   0   0
0007 A 0:ADD_INT_CONST              5   1   2    ; const = 1
0008 A 1:INT_TO_FLOAT              50   0   5
0009 A 1:SLICE_SET_FLOAT_DIRECT    20   0   1
0010   0:EXT                        0   0   0
0011 A 2:TIER2_INC_INT              0   1   1
0012 A 1:JUMP                      74 247 255    ; goto -9
0013 A 0:LOAD_FLOAT_CONST           0   0   0    ; floats[0] = 0
0014 A 1:LOAD_INT_CONST_SMALL      75   1  64    ; ints[1] = 64
0015 G 1:SIMD_SUM_SLICE_FLOAT64   152   0   0
0016   0:EXT                        1   0   0
0017 A 2:TIER2_RETURN               0  10   1    ; 1 values
