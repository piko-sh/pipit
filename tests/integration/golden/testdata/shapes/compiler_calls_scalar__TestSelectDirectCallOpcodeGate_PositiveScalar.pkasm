; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function fib
;   registers: int64=7
;   dispatch:  asm=8 shim=0 exit=0 go=0
;   params:    (int64)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=2  [1]=1

0000 A 1:LESS_THAN_INT64_CONSTANT_THEN_JUMP_IF_FALSE        123   0   0
0001   0:EXTENSION                                            1   0   0
0002 A 2:RETURN                                               0  10   1    ; 1 values
0003 A 0:SUBTRACT_INT64_CONSTANT                              2   0   1    ; const = 1
0004 A 1:CALL_SCALAR                                        134   0   0
0005 A 0:SUBTRACT_INT64_CONSTANT                              5   0   0    ; const = 2
0006 A 1:CALL_SCALAR                                        134   1   0
0007 A 0:ADD_INT64                                            0   3   6
0008 A 2:RETURN                                               0  10   1    ; 1 values

; ═════════════════════════════════════════════════════════════
; function EntrypointRun
;   registers: int64=1
;   dispatch:  asm=3 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=10

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0  10    ; ints[0] = 10
0001 A 1:CALL_SCALAR                                        134   0   0
0002 A 2:RETURN                                               0  10   1    ; 1 values
