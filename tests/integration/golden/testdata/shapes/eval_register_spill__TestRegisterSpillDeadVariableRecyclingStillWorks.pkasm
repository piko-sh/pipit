; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int=4
;   dispatch:  asm=9 shim=0 exit=0 go=1
;   params:    (none)
;   returns:   (int)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=2  [2]=10  [3]=20

0000 A 1:LOAD_INT_CONST_SMALL      75   0   1    ; ints[0] = 1
0001 A 0:ADD_INT_CONST              2   0   1    ; const = 2
0002 G 3:TIER3_NOP                  0   0   0
0003 A 1:LOAD_INT_CONST_SMALL      75   3  10    ; ints[3] = 10
0004 A 1:MOVE_INT                  35   2   3
0005 A 1:LOAD_INT_CONST_SMALL      75   3  20    ; ints[3] = 20
0006 A 1:MOVE_INT                  35   1   3
0007 A 0:ADD_INT                    3   2   1
0008 A 1:MOVE_INT                  35   0   3
0009 A 2:TIER2_RETURN               0  10   1    ; 1 values
