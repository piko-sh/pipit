; pkasm - pipit bytecode assembly
; dispatch: A assembly, S in-loop shim call to Go, X dedicated exit to Go, G generic exit to Go


; ═════════════════════════════════════════════════════════════
; function run
;   registers: int64=4
;   dispatch:  asm=6 shim=0 exit=0 go=0
;   params:    (none)
;   returns:   (int64)
; ═════════════════════════════════════════════════════════════

; constants:
;   ints:    [0]=1  [1]=2  [2]=10  [3]=20

0000 A 1:LOAD_INT64_IMMEDIATE                                75   0   1    ; ints[0] = 1
0001 A 0:ADD_INT64_CONSTANT                                   2   0   1    ; const = 2
0002 A 1:LOAD_INT64_IMMEDIATE                                75   2  10    ; ints[2] = 10
0003 A 1:LOAD_INT64_IMMEDIATE                                75   1  20    ; ints[1] = 20
0004 A 0:ADD_INT64                                            0   2   1
0005 A 2:RETURN                                               0  10   1    ; 1 values
